{
  "name": "@tummycrypt/tinyvectors",
  "version": "1.0.0",
  "private": true,
  "description": "Animated vector blob backgrounds with physics simulation for Svelte 5",
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "license": "Zlib",
  "author": {
    "name": "Jess Sullivan",
    "email": "jess@sulliwood.org"
  },
  "homepage": "https://github.com/xoxd-ai/tinyvectors#readme",
  "bugs": {
    "url": "https://github.com/xoxd-ai/tinyvectors/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xoxd-ai/tinyvectors.git"
  },
  "keywords": [
    "svelte",
    "svelte5",
    "animation",
    "svg",
    "physics",
    "blobs",
    "vectors",
    "skeleton-ui",
    "accessibility",
    "pride",
    "lgbtq"
  ],
  "svelte": "./dist/svelte/index.js",
  "exports": {
    ".": {
      "types": "./dist-types/index.d.ts",
      "svelte": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./core": {
      "types": "./dist-types/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./motion": {
      "types": "./dist-types/motion/index.d.ts",
      "default": "./dist/motion/index.js"
    },
    "./themes": {
      "types": "./dist-types/themes/index.d.ts",
      "default": "./dist/themes/index.js"
    },
    "./themes/css": "./src/themes/vector-colors.css",
    "./svelte": {
      "types": "./dist-types/svelte/index.d.ts",
      "svelte": "./dist/svelte/index.js",
      "default": "./dist/svelte/index.js"
    }
  },
  "files": [
    "CHANGELOG.md",
    "dist",
    "dist-types",
    "src/themes/vector-colors.css",
    "!dist/**/*.test.*",
    "!dist/**/*.spec.*"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "vite build && node scripts/build-declarations.mjs",
    "dev": "vite --config vite.dev.config.ts",
    "dev:watch": "vite build --watch",
    "check": "svelte-check --tsgo --tsconfig ./tsconfig.json",
    "check:release-metadata": "node scripts/check-release-metadata.mjs",
    "check:package": "publint",
    "check:bundle-size": "node scripts/check-bundle-size.mjs",
    "check:package-consumer": "node scripts/check-package-consumer.mjs ./bazel-bin/pkg",
    "test": "vitest run",
    "test:browser:motion": "node scripts/probe-motion-cdp.mjs",
    "test:watch": "vitest",
    "test:pbt": "vitest run --testNamePattern='INVARIANT'"
  },
  "peerDependencies": {
    "svelte": "5.57.2"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.3.1",
    "@types/node": "^22.20.1",
    "fast-check": "^4.10.2",
    "publint": "^0.3.25",
    "svelte": "5.57.2",
    "svelte-check": "4.7.6",
    "typescript": "7.0.2",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  },
  "pnpm": {
    "overrides": {
      "picomatch": "^4.0.4"
    },
    "patchedDependencies": {
      "svelte-check@4.7.6": "patches/svelte-check@4.7.6.patch"
    },
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
