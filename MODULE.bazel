"""
MODULE.bazel for standalone Bazel consumption of @tummycrypt/tinyvectors.

Usage from external repo (xoxd-ai/bazel-registry):
  bazel_dep(name = "tummycrypt_tinyvectors", version = "1.0.0")
"""

module(
    name = "tummycrypt_tinyvectors",
    version = "1.0.0",
    compatibility_level = 1,
)

bazel_dep(name = "aspect_rules_js", version = "2.9.1")
bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "aspect_bazel_lib", version = "2.22.5")
bazel_dep(name = "rules_nodejs", version = "6.7.3")

node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
# Node 22.22.0: Vite 8 needs Node >= 22.12 (engines in package.json); 22.22.0
# is the newest 22.x that rules_nodejs 6.7.3 knows (matches site.scaffold).
node.toolchain(node_version = "22.22.0")

pnpm = use_extension("@aspect_rules_js//npm:extensions.bzl", "pnpm")
pnpm.pnpm(
    name = "pnpm",
    pnpm_version = "10.13.1",
)
use_repo(pnpm, "pnpm")

npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "tummycrypt_tinyvectors_npm",
    pnpm_lock = "//:pnpm-lock.yaml",
    # RU13: npm_translate_lock applies the pnpm `patchedDependencies` and the
    # .pnpmfile.cjs rewrite recorded in pnpm-lock.yaml; both are inputs.
    data = [
        "//:.pnpmfile.cjs",
        "//:package.json",
        "//:patches/svelte-check@4.7.6.patch",
    ],
    # TIN-2099: skip esbuild's `node install.js` postinstall so no build
    # action needs network or a platform binary outside declared inputs
    # (breaks under strict sandbox/worker strategies). Safe because vite
    # drives esbuild through its JS API, which falls back to
    # require.resolve('@esbuild/<platform>/bin/esbuild') at runtime, and
    # pnpm-lock.yaml pins every @esbuild/* platform package.
    lifecycle_hooks = {"esbuild": []},
)

use_repo(npm, "tummycrypt_tinyvectors_npm")
